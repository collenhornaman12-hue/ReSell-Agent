# Frontend (Vite) — copy to .env and fill in real values
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_CLOUDINARY_CLOUD_NAME=<cloud_name>
VITE_CLOUDINARY_UPLOAD_PRESET=<unsigned_preset>
VITE_WORKER_SECRET=dev-secret-change-in-production
VITE_APP_NAME=ResellAgent

# Backend / workers — also needed by scripts/setup-db.mjs
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ANTHROPIC_API_KEY=sk-ant-api03-...

# Apify — required by workers/pricing for eBay sold-comp scraping
# Get your token at https://console.apify.com/account/integrations
# In production: wrangler secret put APIFY_API_TOKEN (in workers/pricing/)
APIFY_API_TOKEN=apify_api_...

# Cloudinary (server-side upload signing, if needed)
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# EasyPost (shipping labels)
EASYPOST_API_KEY=EZ...

# Seller info (used by listing worker)
SELLER_NAME=Your Name
SELLER_STREET1=123 Main St
SELLER_CITY=City
SELLER_STATE=FL
SELLER_ZIP=32792
SELLER_COUNTRY=US
SELLER_PHONE=

# eBay API
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENVIRONMENT=sandbox
EBAY_REDIRECT_URI=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_DEV_ID=
EBAY_USER_REFRESH_TOKEN=

# eBay business policies (required by listing worker)
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_MERCHANT_LOCATION_KEY=

# Push notifications (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

NODE_ENV=development
